process {
    errorStrategy = 'retry'
    maxRetries = 2

    // GBM_seg_v2 loads up to 6 models simultaneously (2 stages x 3 planes) -- easily fits one
    // A10G's 24 GB. 4 vCPU / 14 GB fits a g5.xlarge (4 vCPU / 16 GiB) once AWS Batch's own
    // per-instance memory reservation is accounted for; asking for the full 16 GB would push
    // each task onto a g5.2xlarge for no benefit.
    //
    // maxForks explicitly overridden to a real concurrency limit here: the repo's own
    // conf/gpu.config sets maxForks=1 as a LOCAL-testing safeguard (a single shared workstation
    // GPU can't run multiple `segment` processes at once without VRAM contention). Real
    // Cirro/Batch jobs each get their own dedicated GPU instance, so that constraint doesn't
    // apply here -- but Nextflow merges config per-directive, not per-block, so simply omitting
    // maxForks in this file would NOT reset the 1-at-a-time limit; it must be raised explicitly.
    // Tune to the number of concurrent GPU Batch jobs your project's GPU quota can support.
    withName: 'SEGMENT_GBM' {
        accelerator = 1
        cpus = 4
        memory = 14.GB
        maxForks = 10
        // See .cirro/02-preprocess/process-compute.config: --shm-size has to be set explicitly
        // under AWS Batch. Kept below this task's memory request.
        containerOptions = '--shm-size=8g'
    }
    // Stage 3b (quantify) runs automatically as part of this same pipeline invocation by
    // default (see skip_quantify) -- CPU-only, explicitly sized here rather than left to
    // whatever conf/base.config's process_low label happens to default to, since this file
    // (not that one) is what actually governs a real Cirro/Batch run.
    withName: 'QUANTIFY_VOLUMES' {
        cpus = 2
        memory = 4.GB
    }
}
