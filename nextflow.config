manifest {
    name            = 'astril-nf'
    author          = 'Alexander Ling'
    description     = 'Nextflow wrapper for astril: DICOM ingestion, MRI preprocessing, and GBM segmentation (training excluded).'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.10.0'
    version         = '0.2.0'
}

params {
    // Which stage a run STARTS at: organize | plan_convert | convert | preprocess | segment | quantify
    stage = null
    // The last stage the run executes (each stage feeds the next within one run). null = run
    // through quantify, except a run starting at organize, which always stops there (the patient
    // metadata table has to be filled in by hand before plan_convert). Typical local use, since
    // anything before skull-stripping is PHI (faces): --stage plan_convert --stop_after preprocess,
    // then upload 02-preprocess/upload_preprocessed/ and start at segment.
    stop_after = null

    // Docker image every process runs in -- see process.container below.
    container = 'ghcr.io/alexander-ling/astril-nf:0.2.0'

    outdir = 'results'

    // ---- Stage 0: organize ----
    dicom_dir              = null   // arbitrary/unstructured DICOM root
    organized_dir          = null   // output: structured Patient/Exam/Series tree
    dicom_index            = null   // output: organization index (csv)
    quarantine_dir         = null
    patient_metadata_out   = null   // output: blank metadata table for the user to fill in
    // null = use the task's own allocated CPU count (task.cpus); set explicitly to override.
    // Kept in sync with task.cpus rather than a fixed default so astril's own thread count
    // never exceeds what the process's resource label (conf/base.config) actually requests.
    organize_n_workers     = null

    // ---- Stage 1a: plan conversion ----
    patient_metadata       = null   // filled-in metadata table (user-edited output of stage 0)
    conversion_plan_out    = null   // output: editable conversion plan
    min_slices             = 10

    // ---- Stage 1b: convert ----
    conversion_plan        = null   // input: plan from 1a, optionally user-edited
    nifti_dir              = null   // output: NIfTI library
    convert_n_workers      = null   // null = task.cpus, see organize_n_workers above
    convert_overwrite      = false

    // ---- Stage 2: preprocess ----
    prior_preprocessed_dir = null   // optional: previous Stage 2 output, for incremental merges (only its coreg
                                     // log is used: it pins each patient's registration reference)
    prior_nifti_dirs       = null   // with prior_preprocessed_dir: the earlier raw NIfTI input(s) that library was
                                     // built from, comma-separated -- they're re-preprocessed alongside the new exams
    preprocessed_dir       = null   // output: preprocessed NIfTI library
    // preprocess_brain_mris runs as ONE call over the whole library and fans out per exam
    // internally via this worker count -- set to match your machine's real core count, the same
    // way you'd size a native `preprocess_brain_mris --n_workers N` call. Unlike the other
    // n_workers params, this ALSO drives this stage's cpus/memory request (see conf/gpu.config)
    // rather than the other way around, since astril doesn't budget memory itself.
    preprocess_n_workers            = 8
    // GB of memory requested per worker (conf/gpu.config: memory = n_workers * this, unless
    // preprocess_memory_gb overrides it). astril auto-budgets CPU thread counts per worker
    // itself, but has no equivalent memory budgeting -- this is a starting heuristic, not a
    // measured figure; tune it (or use preprocess_memory_gb directly) against your own data.
    preprocess_memory_gb_per_worker = 4
    // Manual total-memory override in GB. Leave unset (null) to auto-compute as
    // preprocess_n_workers * preprocess_memory_gb_per_worker. If set explicitly and it looks
    // low relative to preprocess_n_workers, main.nf prints a warning (not a hard failure)
    // before running -- an OOM kill (exit 137) part-way through is a much more expensive way to
    // discover the same problem.
    preprocess_memory_gb            = null
    anchor_label           = 'T1c'
    registration_strategy  = 'medium'
    normalization_method   = 'robust_zscore'
    final_dims             = '240,240,155'
    final_voxels           = '1.0,1.0,1.0'
    use_gpu                = true
    enable_tta             = true
    generate_qc            = true
    preprocess_overwrite   = false

    // ---- Stage 3a: segment ----
    // Runs astril's generic, contract-driven `segment` CLI (reads the model's own pipeline.json
    // -- see astril's segment.py/pipeline_contract.py). Exactly one of model_family/model_dir:
    model_family           = 'GBM_seg_v2'   // a family registered in astril's models.json
    model_dir              = null           // OR a path to a self-trained model's own directory
                                             // (its own pipeline.json + checkpoints), for a model
                                             // not published through astril's model manifest yet
    slice_batch_size       = 1
    segment_overwrite      = false
    brainmask_pattern      = '_brainmask.nii.gz'  // also used to locate exam dirs in a directly-uploaded preprocessed library

    // Docker's default /dev/shm is only 64MB, which is way too small for PyTorch multiprocessing
    // (used internally by nnU-Net/HD-BET's data-loading workers) once real (not tiny synthetic
    // test) MRI volumes are involved -- manifests as `RuntimeError: unable to allocate shared
    // memory(shm)... No space left on device` deep inside a torch multiprocessing traceback.
    // Applied to GPU-labeled processes via conf/gpu.config's containerOptions. It's a tmpfs, so
    // raising this costs nothing unless actually used -- no need to be stingy.
    docker_shm_size = '16g'

    // ---- Stage 3b: quantify (follows Stage 3a in the same run unless --stop_after segment, e.g.
    //      to correct masks by hand first, then start a new run at --stage quantify --seg_dir ...) ----
    seg_dir                = null   // Stage 3a output, or manually-edited segmentation masks
    seg_filename_pattern   = '_GBM-seg.nii.gz'
    merge_before_quantify  = false
    merge_input_patterns   = null   // required if merge_before_quantify=true; e.g. '_GBM-seg.nii.gz,_manual-seg.nii.gz'
    merge_output_pattern   = '_merged-seg.nii.gz'
    total_levels           = null   // number of generic levels 1..N to quantify; not needed if labels_json is
                                     // set or matched files carry a segmentation_provenance.json sidecar
                                     // (Stage 3a's segment engine writes one automatically) -- one of the three is required.
    labels_json            = null   // optional explicit labels.json contract path, for entering Stage 3b directly
                                     // with segmentation masks that have no segmentation_provenance.json sidecar
    quantify_n_threads     = null   // null = task.cpus, see organize_n_workers above
}

// Nextflow merges config in file order, and for a given withName/withLabel selector the LAST
// value wins -- so base.config/gpu.config are included FIRST, and the `profiles {}` block
// (whose -profile test/cirro variants override specific processes' resources) comes LAST. This
// used to be reversed, which meant conf/test.config's lighter PREPROCESS_LIBRARY/SEGMENT_GBM
// resource overrides were silently never applied (gpu.config's larger values always won,
// regardless of -profile test) -- caught when a real run failed with a memory request the test
// profile was specifically supposed to shrink.
includeConfig 'conf/base.config'
includeConfig 'conf/gpu.config'

// The published image (see README's Docker section). A param, not a bare literal, so a local
// build (`--container astril-nf:test`) or a Cirro process-compute.config can point elsewhere.
process.container = params.container

profiles {
    docker {
        docker.enabled = true
        // Deliberately NOT running as `-u $(id -u):$(id -g)`: astril's model-cache resolution
        // (astril.paths.preferred_models_dir()) and HD-BET's own weight cache
        // (~/hd-bet_params) are gated on write-access-to / HOME-relative to whichever user the
        // container runs as. The image bakes weights in for its default (root) user; running
        // as an arbitrary host UID would make both caches resolve to a different, empty
        // location and silently trigger runtime downloads. See Dockerfile.
    }
    // Kept as a valid, harmless no-op profile name (so existing `-profile docker,gpu` commands
    // keep working) -- GPU wiring (--gpus all, --shm-size) is applied precisely per-process via
    // conf/gpu.config's `withLabel: gpu { containerOptions = ... }`, which only affects
    // GPU-labeled processes regardless of which profile is active, rather than this
    // docker.runOptions approach applying to every process globally.
    gpu {
    }
    test {
        includeConfig 'conf/test.config'
    }
    cirro {
        // Cirro supplies its own compute overrides via process-compute.config,
        // included on the command line as an additional -c file; nothing extra needed here.
    }
}
