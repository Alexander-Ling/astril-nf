// Minimal-resource profile for running the pipeline locally against a small sample dataset.
params {
    organize_n_workers   = 2
    convert_n_workers    = 2
    preprocess_n_workers = 2
    use_gpu              = false
    enable_tta           = false
}

process {
    withLabel: gpu {
        accelerator = 0
    }
    // No PREPROCESS_LIBRARY override needed here anymore: its cpus/memory are derived from
    // preprocess_n_workers (set to 2 above) via conf/gpu.config's formula automatically.
    withName: 'SEGMENT_GBM' {
        cpus   = 2
        memory = 8.GB
    }
}
