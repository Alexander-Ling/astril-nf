// GPU-labeled processes (HD-BET skull-stripping, GBM segmentation inference).
// The exact Batch/GPU queue name is environment-specific and is expected to be supplied by
// Cirro's own process-compute.config overlay (withName selectors) at registration time; the
// accelerator request here is the portable, executor-agnostic part.
process {
    withLabel: gpu {
        accelerator = 1
        // --shm-size: see params.docker_shm_size in nextflow.config -- both HD-BET (Stage 2)
        // and segmentation inference (Stage 3a) use PyTorch multiprocessing internally, which needs
        // meaningfully more than Docker's 64MB default /dev/shm for real (not tiny synthetic
        // test) MRI volumes.
        containerOptions = {
            workflow.containerEngine == 'docker' ? "--gpus all --shm-size=${params.docker_shm_size}" : null
        }
    }

    // preprocess_brain_mris() handles the WHOLE library in one call (reference selection,
    // batched HD-BET, then its own internal per-exam thread pool) -- cpus and memory are both
    // DERIVED from params.preprocess_n_workers (see nextflow.config), one core and
    // preprocess_memory_gb_per_worker GB per worker by default, since astril auto-budgets CPU
    // thread counts per worker itself but has no equivalent memory budgeting. Override
    // preprocess_n_workers (and preprocess_memory_gb if the per-worker heuristic doesn't fit
    // your data) rather than editing this file for day-to-day tuning.
    withName: 'PREPROCESS_LIBRARY' {
        // .toInteger(): CLI-provided `--preprocess_n_workers 3`-style overrides arrive as
        // Strings, not the Integer type nextflow.config's own default literal has -- multiplying
        // two Strings ("3" * "2") fails ("Unknown method invocation `multiply` on String type"),
        // so every value used in arithmetic here is explicitly coerced first.
        cpus   = { params.preprocess_n_workers.toInteger() }
        memory = {
            def override = params.preprocess_memory_gb
            def total = override ? override.toInteger()
                : params.preprocess_n_workers.toInteger() * params.preprocess_memory_gb_per_worker.toInteger()
            "${total} GB"
        }
        time   = 24.h
    }

    // GBM_seg_v2 loads up to 6 models simultaneously (2 stages x 3 planes).
    //
    // maxForks = 1: unlike Stage 2 (one task, whole library, one controlled GPU call at a
    // time), this stage fans out PER PATIENT -- Nextflow's local executor can launch several
    // SEGMENT_GBM tasks concurrently (it only tracks cpus/memory, not "how many physical GPUs
    // this machine has"), and several concurrent `segment` processes each loading up to 6
    // models would contend for the same GPU's VRAM -- the same failure class as the HD-BET
    // concurrency issue found in Stage 2 testing, just for segmentation instead of
    // skull-stripping. This is a LOCAL-testing default for a single shared GPU; a real Cirro/
    // Batch deployment gives each task its own dedicated GPU instance, so
    // .cirro/03-segment/process-compute.config explicitly raises this back up (Nextflow merges
    // config per-directive, not per-block, so simply omitting maxForks there would NOT reset
    // it -- it has to be overridden explicitly).
    withName: 'SEGMENT_GBM' {
        cpus     = 4
        memory   = 16.GB
        time     = 6.h
        maxForks = 1
    }
}
