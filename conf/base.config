// Default (CPU) resource labels. Cirro overrides these per-process via process-compute.config.
process {
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2

    cpus   = 2
    memory = 4.GB
    time   = 4.h

    withLabel: process_low {
        cpus   = 2
        memory = 4.GB
    }

    withLabel: process_medium {
        cpus   = 4
        memory = 8.GB
    }

    withLabel: process_high {
        cpus   = 8
        memory = 32.GB
        time   = 12.h
    }
}
